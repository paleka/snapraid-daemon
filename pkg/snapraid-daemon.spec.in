Name:           @PACKAGE@
Summary:        SnapRAID Daemon with the Storage page (unofficial fork)
Version:        @PACKAGE_VERSION@
Release:        1%{?dist}
License:        GPL-3.0-or-later
Group:          Applications/System
URL:            https://github.com/paleka/snapraid-daemon
Source0:        https://github.com/paleka/snapraid-daemon/releases/download/v%{version}/@PACKAGE@-%{version}.tar.gz
BuildRequires:  gcc
BuildRequires:  zlib-devel
BuildRequires:  zstd-devel
BuildRequires:  systemd
Requires(post): systemd
Requires(preun): systemd
Requires(postun): systemd
Requires:       snapraid >= 15.0
Requires:       zlib
Requires:       zstd
Recommends:     mergerfs
Recommends:     parted
Recommends:     util-linux
Recommends:     e2fsprogs
Recommends:     xfsprogs
Recommends:     btrfs-progs
Recommends:     hdparm
Recommends:     ethtool
Suggests:       samba
Suggests:       nfs-utils
Recommends:     rsync
Recommends:     smartmontools
Recommends:     curl
Conflicts:      snapraid-daemon
Provides:       snapraid-daemon = %{version}

%description
This is an unofficial fork of SnapRAID Daemon by Andrea Mazzoleni. It adds a
Storage page to the web UI, to set up and maintain a SnapRAID array, with or
without a mergerfs pool. It replaces the snapraid-daemon package and uses the
same program, service and configuration file.

SnapRAID Daemon is a lightweight background service that transforms manual parity
tasks into an automated workflow. It integrates directly with SnapRAID to
coordinate sync and scrub operations via intelligent scheduling, ensuring your
protection stays current without manual command-line intervention.

The service features a built-in Web UI and a comprehensive REST API, providing
both visual oversight and programmatic control. While the dashboard offers
real-time status and health alerts, the API enables seamless integration into
external monitoring stacks for persistent and reliable data protection.

%prep
%setup -q

%build
%configure --with-init-type=systemd --with-systemdsystemunitdir=/usr/lib/systemd/system
make %{?_smp_mflags}

%check
make check

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}%{_sysconfdir}
cp snapraidd.conf.example %{buildroot}%{_sysconfdir}/snapraidd.conf
make install DESTDIR=%{buildroot}

%post
# $1 == 1: This is a brand new installation.
# $1 == 2: This is an upgrade of an existing package.
if [ $1 -eq 1 ] ; then 
    # Initial installation: 
    # Force the service to start immediately and enable it for future boots.
    /usr/bin/systemctl --no-reload enable --now snapraidd.service >/dev/null 2>&1 || :
fi

%preun
# $1 == 0: The package is being completely uninstalled (erased).
# $1 == 1: The package is being upgraded (the old version is being removed to make room for the new).
if [ $1 -eq 0 ] ; then 
    # Package removal:
    # We stop and disable the service only during a total removal. 
    # During an upgrade, we leave it alone so the new version can restart it.
    /usr/bin/systemctl --no-reload stop snapraidd.service 'snapraidd@*.service' >/dev/null 2>&1 || :
    /usr/bin/systemctl --no-reload disable snapraidd.service snapraidd@.service >/dev/null 2>&1 || :
fi

%postun
# $1 == 0: This is the end of a complete uninstallation.
# $1 >= 1: This is an upgrade; the new version is already on the system.
/usr/bin/systemctl daemon-reload >/dev/null 2>&1 || :
if [ $1 -ge 1 ] ; then 
    # Package upgrade:
    # The new binary is now in place. We restart the daemon so it begins running the new code.
    /usr/bin/systemctl try-restart snapraidd.service 'snapraidd@*.service' >/dev/null 2>&1 || :
fi

%files
%license LICENSES/GPL-3.0
%doc AUTHORS HISTORY README snapraidd.conf.example snapraidd.yaml
%{_bindir}/snapraidd
%{_mandir}/man1/snapraidd.1*
%dir %{_datadir}/snapraidd
%{_datadir}/snapraidd/quiet.zip
%{_datadir}/snapraidd/commander.zip
%{_datadir}/snapraidd/brutale.zip
%config(noreplace) %{_sysconfdir}/snapraidd.conf
/usr/lib/systemd/system/snapraidd.service
/usr/lib/systemd/system/snapraidd@.service
